<?xml version="1.0" encoding="utf-8"?>
<!-- Benarkan HTTP cleartext hanya untuk host API sendiri; HTTPS untuk semua yang lain. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">43.134.97.197</domain>
    </domain-config>
</network-security-config>
